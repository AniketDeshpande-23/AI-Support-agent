FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit requests pandas

COPY ui/ ./ui/

RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", \
     "--server.address", "0.0.0.0", \
     "--server.port", "8501", \
     "--server.headless", "true"]
